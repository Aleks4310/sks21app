# Скопируйте этот файл в .env и при необходимости измените значения.
# cp .env.example .env

# Порт HTTP-сервера
PORT=5000

# Подключение к PostgreSQL
# При локальном запуске: DB_HOST=localhost
# При запуске через docker-compose: DB_HOST=db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sks_quest
DB_USER=postgres
DB_PASSWORD=postgre

# Секрет для подписи JWT (ОБЯЗАТЕЛЬНО смените в проде!)
JWT_SECRET=change_me_in_production

# CORS: список разрешённых источников через запятую.
# Пусто = отражать любой источник (удобно для локальной разработки/демо).
# Пример для прода: CORS_ORIGIN=https://app.sks-quest.com,https://admin.sks-quest.com
CORS_ORIGIN=
